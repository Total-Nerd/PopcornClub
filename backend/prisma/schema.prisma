generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                Int       @id @default(autoincrement())
  username          String    @unique
  passwordHash      String
  name              String?
  email             String?
  avatarPath        String?
  role              String    @default("user") // "admin" or "user"
  plexUser          String?
  plexWebhookToken  String?   @unique
  traktUsername     String?
  traktClientId     String?
  plexLastWebhookAt DateTime?

  watchTogetherSession WatchTogetherSession?
  collections         Collection[]
  watchHistory        WatchHistory[]
  episodeCollections  EpisodeCollection[]
  episodeWatchHistory EpisodeWatchHistory[]
  watchHistoryLogs    WatchHistoryLog[]
  customLists         CustomList[]
  ignoredMissingEps   IgnoredMissingEpisode[]
  requests            Request[]
  addedListItems      ListItem[] @relation("AddedListItems")
  hiddenItems         HiddenItem[]
  showSpoilers        Boolean    @default(false)
  comments            Comment[]
  reactions           Reaction[]
  followers           Follows[]  @relation("UserFollowers")
  following           Follows[]  @relation("UserFollowing")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WatchTogetherSession {
  id             Int      @id @default(autoincrement())
  userId         Int      @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabled        Boolean  @default(false)
  participantIds String   @default("[]") // JSON array of participant user IDs
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model SystemSettings {
  id                      Int       @id @default(1)
  tmdbApiKey              String?
  traktUsername           String?
  traktClientId           String?
  plexGlobalWebhookToken  String?
  plexGlobalLastWebhookAt DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
}

model Media {
  id           Int       @id @default(autoincrement())
  tmdbId       Int
  type         String // "movie" or "tv"
  title        String
  overview     String?
  releaseDate  DateTime?
  posterPath   String?
  backdropPath String?
  genres       String?

  collections         Collection[]
  watchHistory        WatchHistory[]
  listItems           ListItem[]
  episodeCollections  EpisodeCollection[]
  episodeWatchHistory EpisodeWatchHistory[]
  localFiles          LocalFile[]
  watchHistoryLogs    WatchHistoryLog[]
  ignoredMissingEps   IgnoredMissingEpisode[]
  requests            Request[]
  hiddenItems         HiddenItem[]
  comments            Comment[]
  reactions           Reaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tmdbId, type])
}

model WatchHistoryLog {
  id          Int      @id @default(autoincrement())
  mediaId     Int
  media       Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  type        String // "movie" or "tv"
  season      Int? // TV only
  episode     Int? // TV only
  watchedAt   DateTime @default(now())
  duration    Int      @default(0) // total duration in seconds
  viewOffset  Int      @default(0) // offset/progress in seconds
  isCompleted Boolean  @default(true) // true = full watch, false = partial watch
  userId      Int?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  watchedWith String?  // JSON string array of co-viewer user IDs, e.g. "[12]"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Collection {
  id          Int      @id @default(autoincrement())
  mediaId     Int
  media       Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  userId      Int?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  collectedAt DateTime @default(now())

  @@unique([userId, mediaId])
}

model WatchHistory {
  id        Int      @id @default(autoincrement())
  mediaId   Int
  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  watchedAt DateTime @default(now())
}

model EpisodeCollection {
  id          Int      @id @default(autoincrement())
  mediaId     Int
  media       Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  season      Int
  episode     Int
  userId      Int?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  collectedAt DateTime @default(now())

  @@unique([userId, mediaId, season, episode])
}

model EpisodeWatchHistory {
  id        Int      @id @default(autoincrement())
  mediaId   Int
  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  season    Int
  episode   Int
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  watchedAt DateTime @default(now())

  @@unique([userId, mediaId, season, episode])
}

model CustomList {
  id           Int        @id @default(autoincrement())
  name         String
  visibility   String     @default("PRIVATE") // PUBLIC, LINK, INVITE
  defaultOrder String     @default("added")
  sharedWith   String     @default("[]") // JSON string of user IDs
  userId       Int
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items        ListItem[]
  shareId          String?    @unique @default(uuid())
  allowOthersToAdd Boolean    @default(false)
  comments         Comment[]
  createdAt        DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([userId, name])
}

model IgnoredMissingEpisode {
  id      Int   @id @default(autoincrement())
  userId  Int
  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaId Int
  media   Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  season  Int
  episode Int

  @@unique([userId, mediaId, season, episode])
}

model ListItem {
  id        Int        @id @default(autoincrement())
  listId    Int
  list      CustomList @relation(fields: [listId], references: [id], onDelete: Cascade)
  mediaId   Int
  media     Media      @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  addedById Int?
  addedBy   User?      @relation("AddedListItems", fields: [addedById], references: [id], onDelete: SetNull)
  addedAt   DateTime   @default(now())

  @@unique([listId, mediaId])
}

model LocalFolder {
  id        Int      @id @default(autoincrement())
  path      String   @unique
  type      String // "movie" or "tv"
  watch     Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LocalFile {
  id                Int       @id @default(autoincrement())
  path              String    @unique
  type              String // "movie" or "tv"
  mediaId           Int
  media             Media     @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  season            Int? // TV only
  episode           Int? // TV only
  endEpisode        Int? // TV only
  lastSeen          DateTime  @default(now())
  missingSince      DateTime? // Track when deleted to implement the 12-hour removal rule
  manuallyCorrected Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model TMDBCache {
  key       String   @id
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Request {
  id           Int      @id @default(autoincrement())
  mediaId      Int
  media        Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  season       Int?     // NULL for movies/shows
  episode      Int?     // NULL for movies/shows/seasons
  userId       Int
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       String   @default("pending") // pending, confirmed, rejected, collected
  rejectReason String?
  autoReject   Boolean  @default(false)
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Comment {
  id          Int         @id @default(autoincrement())
  userId      Int
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  mediaId     Int?
  media       Media?      @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  season      Int?
  episode     Int?
  
  listId      Int?
  list        CustomList? @relation(fields: [listId], references: [id], onDelete: Cascade)

  content     String
  hasSpoilers Boolean     @default(false)
  
  parentId    Int?
  parent      Comment?    @relation("CommentReplies", fields: [parentId], references: [id])
  replies     Comment[]   @relation("CommentReplies")
  
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Reaction {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  mediaId   Int
  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  season    Int?
  episode   Int?
  
  emoji     String
  
  createdAt DateTime @default(now())

  @@unique([userId, mediaId, season, episode, emoji])
}

model Follows {
  followerId  Int
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id])
  followingId Int
  following   User     @relation("UserFollowers", fields: [followingId], references: [id])
  createdAt   DateTime @default(now())

  @@id([followerId, followingId])
}

model HiddenItem {
  id              Int      @id @default(autoincrement())
  userId          Int
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaId         Int
  media           Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  hideInCalendar  Boolean  @default(true)
  hideInLibrary   Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@unique([userId, mediaId])
}
