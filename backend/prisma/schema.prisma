generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                Int       @id @default(autoincrement())
  username          String    @unique
  passwordHash      String
  name              String?
  email             String?
  avatarPath        String?
  role              String    @default("user") // "admin" or "user"
  plexUser          String?
  plexWebhookToken  String?   @unique
  traktUsername     String?
  traktClientId     String?
  plexLastWebhookAt DateTime?

  collections         Collection[]
  watchHistory        WatchHistory[]
  episodeCollections  EpisodeCollection[]
  episodeWatchHistory EpisodeWatchHistory[]
  watchHistoryLogs    WatchHistoryLog[]
  customLists         CustomList[]
  ignoredMissingEps   IgnoredMissingEpisode[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SystemSettings {
  id                      Int       @id @default(1)
  tmdbApiKey              String?
  traktUsername           String?
  traktClientId           String?
  plexGlobalWebhookToken  String?
  plexGlobalLastWebhookAt DateTime?
  tvNamingFormat          String?
  movieNamingFormat       String?
  lastScanTime            DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
}

model Media {
  id           Int       @id @default(autoincrement())
  tmdbId       Int
  type         String // "movie" or "tv"
  title        String
  overview     String?
  releaseDate  DateTime?
  posterPath   String?
  backdropPath String?
  genres       String?

  collections         Collection[]
  watchHistory        WatchHistory[]
  listItems           ListItem[]
  episodeCollections  EpisodeCollection[]
  episodeWatchHistory EpisodeWatchHistory[]
  localFiles          LocalFile[]
  watchHistoryLogs    WatchHistoryLog[]
  ignoredMissingEps   IgnoredMissingEpisode[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tmdbId, type])
}

model WatchHistoryLog {
  id          Int      @id @default(autoincrement())
  mediaId     Int
  media       Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  type        String // "movie" or "tv"
  season      Int? // TV only
  episode     Int? // TV only
  watchedAt   DateTime @default(now())
  duration    Int      @default(0) // total duration in seconds
  viewOffset  Int      @default(0) // offset/progress in seconds
  isCompleted Boolean  @default(true) // true = full watch, false = partial watch
  userId      Int?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Collection {
  id          Int      @id @default(autoincrement())
  mediaId     Int
  media       Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  userId      Int?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  collectedAt DateTime @default(now())

  @@unique([userId, mediaId])
}

model WatchHistory {
  id        Int      @id @default(autoincrement())
  mediaId   Int
  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  watchedAt DateTime @default(now())
}

model EpisodeCollection {
  id          Int      @id @default(autoincrement())
  mediaId     Int
  media       Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  season      Int
  episode     Int
  userId      Int?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  collectedAt DateTime @default(now())

  @@unique([userId, mediaId, season, episode])
}

model EpisodeWatchHistory {
  id        Int      @id @default(autoincrement())
  mediaId   Int
  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  season    Int
  episode   Int
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  watchedAt DateTime @default(now())

  @@unique([userId, mediaId, season, episode])
}

model CustomList {
  id        Int        @id @default(autoincrement())
  name      String
  userId    Int?
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     ListItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([userId, name])
}

model IgnoredMissingEpisode {
  id      Int   @id @default(autoincrement())
  userId  Int
  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaId Int
  media   Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  season  Int
  episode Int

  @@unique([userId, mediaId, season, episode])
}

model ListItem {
  id      Int        @id @default(autoincrement())
  listId  Int
  list    CustomList @relation(fields: [listId], references: [id], onDelete: Cascade)
  mediaId Int
  media   Media      @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  addedAt DateTime   @default(now())

  @@unique([listId, mediaId])
}

model LocalFolder {
  id        Int      @id @default(autoincrement())
  path      String   @unique
  type      String // "movie" or "tv"
  watch     Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LocalFile {
  id                Int       @id @default(autoincrement())
  path              String    @unique
  type              String // "movie" or "tv"
  mediaId           Int
  media             Media     @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  season            Int? // TV only
  episode           Int? // TV only
  endEpisode        Int? // TV only
  lastSeen          DateTime  @default(now())
  missingSince      DateTime? // Track when deleted to implement the 12-hour removal rule
  manuallyCorrected Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model TMDBCache {
  key       String   @id
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StagingItem {
  id            Int      @id @default(autoincrement())
  path          String   @unique
  filename      String
  parsedType    String?  // "movie" or "tv"
  parsedTitle   String?
  parsedYear    Int?
  parsedSeason  Int?
  parsedEpisode Int?
  tmdbId        Int?
  status        String   @default("pending") // "pending", "sorted", "error"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
